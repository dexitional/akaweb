# Copy to .env.local for local dev, or .env.production for deploys.
# Must match packages/db's DATABASE_URL.
DATABASE_URL="mysql://root:your_password_here@localhost:3306/akaweb"

# Signs the admin (CMS) session cookie. At least 32 random characters.
ADMIN_SESSION_SECRET=your_random_secret_here_min_32_chars

# Public site origin — used for canonical links and CORS.
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Cloudflare R2 — every CMS asset (images, PDFs, documents) lives here.
# The bucket's CORS policy must allow PUT from APP_URL's origin, and
# R2_PUBLIC_DOMAIN must serve the bucket publicly (custom domain or r2.dev).
R2_REGION=auto
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=akatsi-cms
R2_PUBLIC_DOMAIN=https://cdn.akatsicoe.edu.gh
